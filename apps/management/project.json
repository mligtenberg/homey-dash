{
  "name": "management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "hd",
  "sourceRoot": "apps/management/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/management",
        "browser": "apps/management/src/main.ts",
        "tsConfig": "apps/management/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/management/public"
          }
        ],
        "styles": [
          "libs/design-system/src/index.css",
          "apps/management/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201,
        "proxyConfig": "apps/management/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "management:build:production"
        },
        "development": {
          "buildTarget": "management:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "management:build:development",
        "tsConfig": "apps/management/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "management:build",
        "port": 4201,
        "staticFilePath": "dist/apps/management/browser",
        "spa": true
      }
    }
  },
  "implicitDependencies": ["design-system"]
}
