{
  "name": "voice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/voice",
  "tags": [],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/voice",
        "command": "uv sync --inexact --extra needle"
      },
      "configurations": {
        "all": {
          "command": "uv sync --inexact --extra needle --extra model"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "install",
        "assets"
      ],
      "options": {
        "cwd": "apps/voice",
        "command": "HOMEY_DASH_URL=${HOMEY_DASH_URL:-http://localhost:5112} uv run uvicorn app:app --port {args.port} --reload",
        "port": 8765
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/voice",
        "command": "uv run pytest -q"
      }
    },
    "assets": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/voice",
        "command": "./fetch_assets.sh"
      },
      "cache": false
    }
  }
}
