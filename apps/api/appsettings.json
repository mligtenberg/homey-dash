{
  "ConnectionStrings": {
    "HomeyDash": "Data Source=homey-dash.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "management": {
        "ClusterId": "management",
        "Match": { "Path": "/admin/{**catch-all}" }
      },
      "display": {
        "ClusterId": "display",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "management": {
        "Destinations": { "management": { "Address": "http://localhost:4201" } }
      },
      "display": {
        "Destinations": { "display": { "Address": "http://localhost:4200" } }
      }
    }
  }
}
