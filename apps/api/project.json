{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "implicitDependencies": ["airplay"],
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/bin/**/*",
        "!{projectRoot}/obj/**/*",
        "!{projectRoot}/*.db*"
      ],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "dotnet publish apps/api/HomeyDash.Api.csproj -c Release -o dist/apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/api",
        "command": "dotnet watch --non-interactive run"
      },
      "configurations": {
        "simulator": {
          "command": "dotnet watch --non-interactive run -- --Homey:Fake=true --Immich:Fake=true --Plex:Fake=true --Weather:Fake=true --Traffic:Fake=true --News:Fake=true"
        }
      }
    },
    "migration-add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet ef migrations add {args.name} --project apps/api"
      }
    }
  }
}
