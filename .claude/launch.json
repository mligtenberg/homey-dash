{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/api",
        "--no-launch-profile",
        "--artifacts-path",
        "tmp/claude/api",
        "--",
        "--environment",
        "Development",
        "--urls",
        "http://localhost:5212",
        "--ConnectionStrings:HomeyDash=Data Source=../../tmp/claude/homey-dash.db",
        "--ReverseProxy:Clusters:display:Destinations:display:Address=http://localhost:4300",
        "--ReverseProxy:Clusters:management:Destinations:management:Address=http://localhost:4301"
      ],
      "port": 5212
    },
    {
      "name": "api-fake",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/api",
        "--no-launch-profile",
        "--artifacts-path",
        "tmp/claude/api",
        "--",
        "--environment",
        "Development",
        "--urls",
        "http://localhost:5212",
        "--ConnectionStrings:HomeyDash=Data Source=../../tmp/claude/homey-dash.db",
        "--Homey:Fake=true",
        "--Immich:Fake=true",
        "--Plex:Fake=true",
        "--AirPlay:Fake=true",
        "--Weather:Fake=true",
        "--Traffic:Fake=true",
        "--ReverseProxy:Clusters:display:Destinations:display:Address=http://localhost:4300",
        "--ReverseProxy:Clusters:management:Destinations:management:Address=http://localhost:4301"
      ],
      "port": 5212
    },
    {
      "name": "display",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NX_WORKSPACE_DATA_DIRECTORY=tmp/claude/nx",
        "NX_DAEMON=false",
        "npx",
        "nx",
        "serve",
        "display",
        "--port",
        "4300",
        "--proxy-config",
        ".claude/proxy.json"
      ],
      "port": 4300
    },
    {
      "name": "management",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NX_WORKSPACE_DATA_DIRECTORY=tmp/claude/nx",
        "NX_DAEMON=false",
        "npx",
        "nx",
        "serve",
        "management",
        "--port",
        "4301",
        "--proxy-config",
        ".claude/proxy.json"
      ],
      "port": 4301
    },
    {
