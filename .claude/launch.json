        "--AirPlay:Fake=true",
        "--Weather:Fake=true",
        "--Traffic:Fake=true",
        "--ReverseProxy:Clusters:display:Destinations:display:Address=http://localhost:4302",
        "--ReverseProxy:Clusters:management:Destinations:management:Address=http://localhost:4303"
      ],
      "port": 5213
    },
