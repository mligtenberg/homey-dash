{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@homey-dash/layout": ["./libs/layout/src/index.ts"],
      "@homey-dash/tiles": ["./libs/tiles/src/index.ts"],
      "@homey-dash/api-client": ["./libs/api-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
